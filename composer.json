{
  "name": "matthummel/walkridge",
  "type": "wordpress-theme",
  "license": "GPL-2.0-or-later",
  "description": "Sage 11 theme for licensed-guide battlefield tours",
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "require": {
    "php": ">=8.3",
    "roots/acorn": "^5.0 || ^6.0"
  },
  "require-dev": {
    "laravel/pint": "^1.20"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "roots/acorn": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Roots\\Acorn\\ComposerScripts::postAutoloadDump"
    ]
  }
}
